# Sao chép thành .env (local) hoặc set trên Railway/Render dashboard.
# Chạy local:  node --env-file=.env src/index.js
# QUAN TRỌNG: local và Render PHẢI khác ZALO_CRED_ID (vd local=local, render=default)
# để tách phiên Zalo — nếu trùng credId + chạy song song sẽ dính lỗi 311 khi gửi lời mời.

# Local nên đặt 10000 cho khớp tài liệu; trên Render KHÔNG cần set (Render tự inject PORT).
PORT=10000

# Token bảo vệ /api. Đặt 1 chuỗi ngẫu nhiên dài. Để trống = tắt bảo vệ (chỉ local).
WORKER_API_TOKEN=

# Supabase — lấy ở Project Settings > API. PHẢI là service_role key (không phải anon).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Khóa mã hóa credential. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZALO_ENC_KEY=

# URL public của worker (để n8n callback resume flow). KHÔNG có / cuối.
PUBLIC_BASE_URL=https://your-worker.onrender.com

# "Ngăn tủ" credential trong bảng zalo_credentials. Local dùng "local", Render dùng "default".
ZALO_CRED_ID=local
ZALO_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
